ENVIRONMENT=development
DATABASE_URL=sqlite:////var/data/civicconnect.db
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=https://civicconnect.onrender.com
# Add the exact LAN IP/custom hostname when accessing the app through it.
# Example: TRUSTED_HOSTS=192.168.1.20,app.example.com
TRUSTED_HOSTS=
UPLOADS_DIR=/var/data/uploads
FRONTEND_DIST_DIR=/app/frontend/dist
ACCESS_TOKEN_EXPIRE_MINUTES=60
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@civicconnect.app
