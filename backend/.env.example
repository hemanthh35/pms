ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:<password>@<supabase-host>:5432/postgres
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
# Add the exact LAN IP/custom hostname when accessing the app through it.
# Example: TRUSTED_HOSTS=192.168.1.20,app.example.com
TRUSTED_HOSTS=
UPLOADS_DIR=/var/data/uploads
FRONTEND_DIST_DIR=/app/frontend/dist
ACCESS_TOKEN_EXPIRE_MINUTES=60
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@civicconnect.app
# Project Settings -> API in the Supabase dashboard. SERVICE_ROLE_KEY is secret —
# backend-only, never send it to the frontend. Leave both blank to fall back to local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-images
